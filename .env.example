# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traceimpact
DB_USER=postgres
DB_PASSWORD=

# Application Settings
ENV=development
LOG_LEVEL=INFO

# TraceImpact 2.0 Automated Pipeline Scheduler
PIPELINE_SCHEDULE_INTERVAL_HOURS=24
PIPELINE_RUN_ON_STARTUP=true
PIPELINE_LOOKBACK_YEARS=3

